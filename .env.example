# Auto selects Supabase when its secret key is set. Local is only for development.
# Use supabase to require the remote database without a local fallback.
RACKER_STORAGE=auto

# Supabase endpoint used by Racker.
SUPABASE_URL=https://yadzaradfcojbrxpdahk.supabase.co

# Server-only secret from Supabase > Settings > API Keys. Never put it in the frontend.
# An anon/public key cannot replace this server-side secret.
SUPABASE_SECRET_KEY=

# Set your own password (12-256 characters). Required in Netlify Functions.
ADMIN_PASSWORD=

HOST=127.0.0.1
PORT=3000
